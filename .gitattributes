# Force LF line endings for shell scripts — bash (MSYS2 / Linux) fails on CRLF.
*.sh    text eol=lf

# Consistent LF for all text files (Python, YAML, Markdown).
*.py    text eol=lf
*.yml   text eol=lf
*.yaml  text eol=lf
*.md    text eol=lf
*.toml  text eol=lf
*.json  text eol=lf
*.txt   text eol=lf
*.cfg   text eol=lf
*.ini   text eol=lf

# Prevent CRLF corruption of Excel input/output files.
*.xls   binary
*.xlsx  binary
